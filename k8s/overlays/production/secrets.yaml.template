# TaskFlow Secrets Template
# IMPORTANT: Copy this file to secrets.yaml and fill in your actual values
# NEVER commit the actual secrets.yaml file to version control!
#
# To create the secret:
# 1. Copy this file: cp secrets.yaml.template secrets.yaml
# 2. Fill in the actual values in secrets.yaml
# 3. Apply: kubectl apply -f secrets.yaml -n taskflow-prod

apiVersion: v1
kind: Secret
metadata:
  name: taskflow-secrets
  labels:
    app: taskflow
    environment: production
type: Opaque
stringData:
  # ==========================================================================
  # DATABASE CREDENTIALS (Neon Serverless PostgreSQL)
  # ==========================================================================
  DATABASE_URL: "postgresql://user:password@host:5432/database?sslmode=require"

  # ==========================================================================
  # AUTHENTICATION SECRETS
  # ==========================================================================
  # JWT signing key - generate with: openssl rand -hex 32
  SECRET_KEY: "your-secret-key-at-least-256-bits-long"
  JWT_SECRET_KEY: "your-jwt-secret-key"

  # BetterAuth secret - generate with: openssl rand -hex 32
  BETTER_AUTH_SECRET: "your-better-auth-secret"

  # ==========================================================================
  # AI SERVICE CREDENTIALS
  # ==========================================================================
  # Gemini API key from Google AI Studio
  GEMINI_API_KEY: "your-gemini-api-key"

  # ==========================================================================
  # EMAIL SERVICE CREDENTIALS (Brevo/Sendinblue)
  # ==========================================================================
  BREVO_API_KEY: "your-brevo-api-key"
  EMAIL_FROM: "noreply@your-domain.com"
